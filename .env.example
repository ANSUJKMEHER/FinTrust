# FinTrust RAG Environment Configuration
# Copy this file to .env and adjust variables as required.

PROJECT_NAME="FinTrust RAG"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL 16 with pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="fintrust_user"
POSTGRES_PASSWORD="fintrust_secure_password"
POSTGRES_DB="fintrust_db"
# If DATABASE_URL is provided, it takes precedence.
DATABASE_URL="postgresql://fintrust_user:fintrust_secure_password@localhost:5432/fintrust_db"

# Security & JWT (Generate a 64+ character secret in production, e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY="insecure_default_dev_secret_change_in_production_min_32_bytes_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing (Argon2id parameters)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Rate Limiting & Audit
AUDIT_LOG_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
