# FinTrust RAG Environment Configuration
# Copy this file to .env and adjust variables as required.

PROJECT_NAME="FinTrust RAG"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="fintrust_user"
POSTGRES_PASSWORD="change_to_a_strong_random_password_min_16_chars"
POSTGRES_DB="fintrust_db"
DATABASE_URL="postgresql://fintrust_user:change_to_a_strong_random_password_min_16_chars@postgres:5432/fintrust_db"

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
# Generate a cryptographically secure 64+ char secret: `openssl rand -hex 32`
JWT_SECRET_KEY="replace_with_a_secure_random_production_secret_key_at_least_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing (Argon2id RFC 9106 Parameters)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Rate Limiting & DoS Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_RAG_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Structured Logging & Observability
AUDIT_LOG_ENABLED=true
LOG_FORMAT="json"

# Ingestion & Storage
MAX_UPLOAD_SIZE_BYTES=52428800
DOCUMENT_STORAGE_DIR="storage/documents"

# LLM & RAG Engine Settings
LLM_PROVIDER="mock" # Options: "mock", "openai", "anthropic"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_API_KEY=""
LLM_API_BASE=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# RAG Evidence & Sufficiency
RAG_MAX_CONTEXT_TOKENS=3000
RAG_SUFFICIENCY_MIN_SCORE=0.30
